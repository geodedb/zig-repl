.{
    .name = .repl,
    .version = "0.1.20",
    .fingerprint = 0xc555ea454f750183,
    .minimum_zig_version = "0.16.0",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tests",
        "README.md",
        "LICENSE",
    },
    .dependencies = .{
        // Otel observability dep. Lazy: only fetched when the build
        // reaches `b.lazyDependency("otel", ...)` under `-Dwith_otel=true`.
        // With the flag off the dependency is never resolved and the
        // produced artifact contains zero otel symbols (verified by
        // otel/scripts/verify-consumer-noop.sh).
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git?ref=v0.1.26#36b56fa3cce4161b8c3db60b16ca986234f0cfd5",
            .hash = "otel-0.1.26-B0v3ltusNQDirCpbgd4p9Pjotmhyr1lL54hcsVrYwKtj",
            .lazy = true,
        },
    },
}
